aws_region         = "ap-northeast-2"
avatar_bucket_name = "replace-with-your-avatar-bucket"

# 선택 사항: 기본값은 x86_64 t3.small 및 20 GiB gp3입니다.
# server_instance_type    = "t3.small"
# server_root_volume_size = 20

# 선택 사항: 기본값은 Single-AZ db.t3.micro, MySQL 3306 IPv4 전체 허용입니다.
# database_instance_class     = "db.t3.micro"
# database_allowed_ipv4_cidrs = ["0.0.0.0/0"]
